<?xml version="1.0" encoding="utf-8"?>
<!--
    Gerenciador multi-pacote de mapas offline do Brasil (cidades e estados).
    Mostra espaço livre no aparelho (StatFs), progresso com botão Cancelar,
    lista de pacotes instalados (Abrir / Remover) e pacotes disponíveis no catálogo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offlinePackScrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_map_scrim"
    android:clickable="true"
    android:elevation="22dp"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/offlinePackSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_map_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/plus_jakarta_sans"
                    android:text="Mapas Offline · Brasil"
                    android:textColor="@color/drifly_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPackStatusSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Mapa online em todo o Brasil · baixe sua região para rotas offline"
                    android:textColor="@color/drifly_mut"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPackSheetClose"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_light_circle"
                android:clickable="true"
                android:contentDescription="Fechar"
                android:focusable="true"
                android:gravity="center"
                android:text="×"
                android:textColor="@color/drifly_mut"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- Espaço livre no aparelho (StatFs) -->
        <TextView
            android:id="@+id/tvPackFreeSpace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Espaço disponível: calculando..."
            android:textColor="@color/drifly_mut"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Barra de progresso + botão Cancelar (visível durante download/extração) -->
        <LinearLayout
            android:id="@+id/layoutPackProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_light_field"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pbPackProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_bar_gradient" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPackProgressLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/drifly_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnPackCancelDownload"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_light_pill_red"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="Cancelar"
                    android:textColor="@color/drifly_red"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Erro de download / espaço insuficiente -->
        <TextView
            android:id="@+id/tvPackError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_light_red_soft"
            android:padding="10dp"
            android:textColor="@color/drifly_red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Lista rolável de pacotes instalados + catálogo Brasil -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxHeight="340dp"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="INSTALADOS NO APARELHO"
                    android:textColor="@color/drifly_mut"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInstalledPacksEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_light_field"
                    android:padding="10dp"
                    android:text="Nenhum pacote offline instalado ainda. Você pode navegar pelo mapa online e baixar sua região abaixo."
                    android:textColor="@color/drifly_mut"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/llInstalledPacks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="REGIÕES E ESTADOS DO BRASIL"
                    android:textColor="@color/drifly_mut"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/llAvailablePacks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
