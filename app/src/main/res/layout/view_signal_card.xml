<?xml version="1.0" encoding="utf-8"?>
<!--
    Card do pino selecionado (.pcard do protótipo).
    Inflado dentro de fragment_map.xml com <include>, encostado na base do mapa.
    A cor do bloco do ícone, o chip de status, a barra e os botões de voto são
    estilizados em MapFragment (as cores vêm do tipo do sinal).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/signalCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_map_card"
    android:elevation="10dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:visibility="gone">

    <!-- Cabeçalho: ícone do tipo, título/subtítulo e botão fechar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/cardIconBox"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_map_icon_box"
            android:padding="9dp">

            <ImageView
                android:id="@+id/cardIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Tipo do sinal" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/drifly_ink"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/drifly_mut"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/cardClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_light_circle"
            android:contentDescription="Fechar"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/drifly_mut"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- Bloco da dica (só aparece para o tipo "dica") -->
    <TextView
        android:id="@+id/cardTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:textColor="#5B4300"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Chip de status + barra de confiança + porcentagem -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cardStatusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true" />

        <FrameLayout
            android:id="@+id/cardBarTrack"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1">

            <View
                android:id="@+id/cardBarFill"
                android:layout_width="0dp"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:id="@+id/cardBarPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/drifly_mut"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Pergunta + botões de voto (substituídos pelo cadeado quando não pode votar) -->
    <LinearLayout
        android:id="@+id/cardVoteRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/cardQuestion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/drifly_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardVoteYes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/cardVoteNo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardLockRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/cardLockIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Bloqueado"
            android:src="@drawable/ic_map_lock" />

        <TextView
            android:id="@+id/cardLockText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/drifly_mut"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Botão principal: navegar 100% offline dentro do DriFly -->
    <TextView
        android:id="@+id/cardNavigateDrifly"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_primary_gradient"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:text="Navegar no DriFly"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:textStyle="bold" />

    <!-- Atalhos secundários: abrir rota no Google Maps ou no Waze -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/cardMaps"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Google Maps"
            android:textColor="@color/drifly_ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardWaze"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_light_btn_secondary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Waze"
            android:textColor="@color/drifly_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardReport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:singleLine="true"
        android:text="Denunciar"
        android:textColor="@color/drifly_mut"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Ação do autor/curador: só aparece quando o sinal é meu (MapFragment). -->
    <TextView
        android:id="@+id/cardRemove"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:maxLines="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:singleLine="true"
        android:text="Remover sinal"
        android:textColor="@color/drifly_red"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
